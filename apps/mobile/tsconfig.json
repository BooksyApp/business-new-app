{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react", "../../node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*", "../../node_modules/@types/react/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
